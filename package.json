{
  "name": "capheden",
  "version": "0.1.0",
  "displayName": "Cà Phê Đen",
  "description": "A beautiful macOS terminal app that keeps your Mac awake.",
  "keywords": [
    "caffeinate",
    "keep-awake",
    "prevent-sleep",
    "macos",
    "cli",
    "ink",
    "react",
    "tui",
    "terminal",
    "coffee"
  ],
  "license": "MIT",
  "author": "Awilum",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Awilum/capheden.git"
  },
  "bugs": {
    "url": "https://github.com/Awilum/capheden/issues"
  },
  "homepage": "https://github.com/Awilum/capheden#readme",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "capheden": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=high",
    "build:standalone": "node scripts/build-standalone.mjs",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
